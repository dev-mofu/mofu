# Copy to .dev.vars for local development. Never commit .dev.vars.
# Production values are set with `wrangler secret put <NAME>`.

# The owner's OpenRouter key that pays for the free tier.
OPENROUTER_API_KEY=
# Cloudflare's always-passes Turnstile test secret. Use the real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# At least 32 random characters. Signs the session cookie.
SESSION_SECRET=
