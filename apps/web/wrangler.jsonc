{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mofu-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The public domain (a Cloudflare zone in this account). With routes set, Wrangler turns the
  // workers.dev URL off unless it's enabled explicitly; keep it, so older links still work.
  "workers_dev": true,
  // No per-version preview URLs: they'd be public copies outside the Turnstile hostnames.
  "preview_urls": false,
  "routes": [
    { "pattern": "mofu.works", "custom_domain": true },
    { "pattern": "www.mofu.works", "custom_domain": true },
  ],
  "assets": {
    // The React app is a single-page app; only /api/* reaches the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "USAGE_LIMITER", "class_name": "UsageLimiter" },
      { "name": "VOTES", "class_name": "VoteStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UsageLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["VoteStore"] },
  ],
  "vars": {
    "DEFAULT_MODEL": "anthropic/claude-haiku-5.5",
    "FREE_DAILY_LIMIT": "10",
    // Kill switch: set to "false" to stop spending on the free tier. BYOK keeps working.
    "FREE_TIER_ENABLED": "true",
    // Cloudflare's always-passes test key. Replace with the production site key at launch.
    // Production site key (public). Local development uses the test key from .dev.vars.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF8ddGpy3ROnj6Tt",
    // $MOFU holder perks: a wallet holding at least HOLDER_MIN_TOKENS (whole tokens) gets
    // HOLDER_DAILY_LIMIT messages a day instead of FREE_DAILY_LIMIT. Balance is read on Robinhood Chain.
    "HOLDER_TOKEN": "0xf76593c1c321c2a2f77775025e9677999ce7ea8c",
    // Comma-separated, tried in order. The official RPC rate-limits Cloudflare's IPs, so it's last.
    "HOLDER_RPC_URL": "https://robinhood-rpc.publicnode.com,https://robinhood.drpc.org,https://rpc.mainnet.chain.robinhood.com",
    "HOLDER_DECIMALS": "18",
    "HOLDER_MIN_TOKENS": "1000000",
    "HOLDER_DAILY_LIMIT": "30",
    // Token Scanner: scans a day per IP, and per wallet for $MOFU holders.
    "SCAN_FREE_DAILY": "10",
    "SCAN_HOLDER_DAILY": "50",
    // MCP server at /mcp: tool calls a day per IP (scan_token, check_dependencies).
    "MCP_DAILY_LIMIT": "50",
    // Mofu Town tower: top holders come from GoldRush; the key is the GOLDRUSH_API_KEY secret.
    "GOLDRUSH_CHAIN": "robinhood-mainnet",
  },
}
