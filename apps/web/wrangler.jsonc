{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mofu-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The public domain (a Cloudflare zone in this account). With routes set, Wrangler turns the
  // workers.dev URL off unless it's enabled explicitly; keep it, so older links still work.
  "workers_dev": true,
  // No per-version preview URLs: they'd be public copies outside the Turnstile hostnames.
  "preview_urls": false,
  "routes": [
    { "pattern": "mofu.works", "custom_domain": true },
    { "pattern": "www.mofu.works", "custom_domain": true },
  ],
  "assets": {
    // The React app is a single-page app; only /api/* reaches the Worker first.
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Token pages (/token/0x…) and their sitemap are rendered by the Worker too.
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/token",
      "/token/*",
      "/creators",
      "/creators/*",
      "/creator/*",
      "/radar",
      "/radar/*",
      "/sitemap-tokens.xml",
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "USAGE_LIMITER", "class_name": "UsageLimiter" },
      { "name": "VOTES", "class_name": "VoteStore" },
      { "name": "STATS", "class_name": "StatsStore" },
      { "name": "WEBHOOKS", "class_name": "WebhookStore" },
      { "name": "PUBLISHER", "class_name": "VerdictPublisher" },
      { "name": "RADAR", "class_name": "RadarStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UsageLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["VoteStore"] },
    { "tag": "v3", "new_sqlite_classes": ["StatsStore"] },
    { "tag": "v4", "new_sqlite_classes": ["WebhookStore"] },
    { "tag": "v5", "new_sqlite_classes": ["VerdictPublisher"] },
    { "tag": "v6", "new_sqlite_classes": ["RadarStore"] },
  ],
  "vars": {
    // New Token Radar: "false" stops it. Scans per run (a run every 2 min, every 45 s with a backlog);
    // one full scan uses most of an invocation's 50 subrequests on the Workers Free plan.
    "RADAR_ENABLED": "true",
    "RADAR_PER_RUN": "1",
    "DEFAULT_MODEL": "anthropic/claude-haiku-5.5",
    "FREE_DAILY_LIMIT": "10",
    // Kill switch: set to "false" to stop spending on the free tier. BYOK keeps working.
    "FREE_TIER_ENABLED": "true",
    // Cloudflare's always-passes test key. Replace with the production site key at launch.
    // Production site key (public). Local development uses the test key from .dev.vars.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF8ddGpy3ROnj6Tt",
    // $MOFU holder perks: a wallet holding at least HOLDER_MIN_TOKENS (whole tokens) gets
    // HOLDER_DAILY_LIMIT messages a day instead of FREE_DAILY_LIMIT. Balance is read on Robinhood Chain.
    "HOLDER_TOKEN": "0xf76593c1c321c2a2f77775025e9677999ce7ea8c",
    // Comma-separated, tried in order. The official RPC rate-limits Cloudflare's IPs, so it's last.
    "HOLDER_RPC_URL": "https://robinhood-rpc.publicnode.com,https://robinhood.drpc.org,https://rpc.mainnet.chain.robinhood.com",
    "HOLDER_DECIMALS": "18",
    "HOLDER_MIN_TOKENS": "1000000",
    "HOLDER_DAILY_LIMIT": "30",
    // Token Scanner: scans a day per IP, and per wallet for $MOFU holders.
    "SCAN_FREE_DAILY": "10",
    "SCAN_HOLDER_DAILY": "50",
    // MCP server at /mcp and the public API at /api/v1 (and mofu-cli scan/wallet): one shared
    // allowance of calls a day per IP.
    "MCP_DAILY_LIMIT": "50",
    // Mofu Guard extension: contract checks a day per IP (each signing prompt and hover scan).
    "GUARD_DAILY_LIMIT": "500",
    // Token pages: uncached scans a day per IP (pages are cached for 30 minutes after a scan).
    "PAGE_DAILY_LIMIT": "300",
    // Webhooks: new webhooks a day per IP (test events get four times this).
    "WEBHOOK_DAILY_LIMIT": "5",
    // On-chain verdicts: the MofuVerdicts registry on Robinhood Chain. Empty = off. The writer's key
    // is the VERDICT_SIGNER_KEY secret (set it with wrangler secret put; never in this file).
    "VERDICTS_CONTRACT": "0xB53d9d9a286e1b57118b1634c2dd46CFb05Ee97d",
    // Publishing transactions a day (each carries up to 25 changed verdicts).
    "VERDICT_DAILY_TXS": "48",
    // Mofu Town tower: top holders come from GoldRush; the key is the GOLDRUSH_API_KEY secret.
    "GOLDRUSH_CHAIN": "robinhood-mainnet",
  },
}
