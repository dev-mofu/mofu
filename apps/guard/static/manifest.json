{
  "manifest_version": 3,
  "name": "Mofu Guard",
  "short_name": "Mofu Guard",
  "version": "0.1.0",
  "description": "Checks what your wallet is about to sign. Warns about unlimited approvals, permits and likely drainers.",
  "homepage_url": "https://mofu.works/guard/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mofu Guard",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://mofu.works/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
