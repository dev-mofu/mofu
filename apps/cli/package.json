{
  "name": "mofu-cli",
  "version": "0.3.0",
  "description": "An AI agent in your terminal: coding tasks, code review, secret scanning, Solidity checks, and Robinhood Chain token and wallet checks.",
  "license": "MIT",
  "homepage": "https://mofu.works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-mofu/mofu.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/dev-mofu/mofu/issues"
  },
  "type": "module",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "openrouter",
    "coding-assistant",
    "data-analysis",
    "openapi",
    "security",
    "robinhood-chain",
    "token-scanner",
    "webhooks",
    "secret-scanning",
    "solidity",
    "code-review",
    "github-action"
  ],
  "bin": {
    "mofu": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "node build.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@scalar/openapi-parser": "0.29.16",
    "ai": "^7.0.166",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.14",
    "pdfjs-dist": "6.5.438",
    "picocolors": "^1.1.1",
    "pyodide": "314.0.7",
    "semver": "^7.8.6",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mofu/core": "workspace:*",
    "esbuild": "0.28.2"
  }
}
