{
  "name": "mofu-monorepo",
  "license": "MIT",
  "homepage": "https://mofu.works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-mofu/mofu.git"
  },
  "bugs": {
    "url": "https://github.com/dev-mofu/mofu/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/cli --noEmit && pnpm --filter @mofu/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mofu": "tsx --conditions=mofu-source apps/cli/src/index.ts",
    "dev:web": "pnpm --filter @mofu/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
